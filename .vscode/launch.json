{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Edge",
            "request": "launch",
            "type": "msedge",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:8080/tmp.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Open tmp.html",
            "type": "node-terminal",
            "request": "launch",
            "command": "Invoke-Item 'E:/cloud/1/tmp.html'",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Start HTTP Server",
            "type": "node-terminal",
            "request": "launch",
            "command": "powershell -ExecutionPolicy Bypass -File smart-server.ps1",
            "cwd": "${workspaceFolder}"
        }
   
}